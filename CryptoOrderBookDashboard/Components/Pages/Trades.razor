@page "/trades"
@using System.Globalization
@using System.Linq
@inject IOptions<OrderBookDashboardOptions> Options

<PageTitle>Trades</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <label for="tradeSymbolSelect" class="mb-0">Symbol:</label>
    <select id="tradeSymbolSelect" class="form-select w-auto" @bind="_selectedSymbol">
        <option value="BTCUSDT">BTC</option>
        <option value="ETHUSDT">ETH</option>
        <option value="SOLUSDT">SOL</option>
        <option value="AAVEUSDT">AAVE</option>
        <option value="ONDOUSDT">ONDO</option>
        <option value="WLDUSDT">WLD</option>
        <option value="BNBUSDT">BNB</option>
    </select>

    <label for="tradeMinNotionalSelect" class="mb-0">Trade size:</label>
    <select id="tradeMinNotionalSelect" class="form-select w-auto" @bind="_selectedRangeKey">
        <option value="0:10000">&lt; $10k</option>
        <option value="10000:50000">$10k – $50k</option>
        <option value="50000:250000">$50k – $250k</option>
        <option value="250000:1000000">$250k – $1M</option>
        <option value="1000000:5000000">$1M – $5M</option>
        <option value="5000000:25000000">$5M – $25M</option>
        <option value="25000000:50000000">$25M – $50M</option>
        <option value="50000000:100000000">$50M – $100M</option>
        <option value="100000000:">$100M+</option>
    </select>
</div>

@{
    var tracked = Options.Value.Symbols.FirstOrDefault(s => s.Symbol == _selectedSymbol);
}
@if (tracked is not null)
{
    <div class="row mb-4">
        @foreach (var market in tracked.Markets)
        {
            <div class="col-md-6">
                <TradeTapePanel Market="@market" Symbol="@tracked.Symbol" MinNotionalUsd="MinNotionalUsd" MaxNotionalUsd="MaxNotionalUsd" />
            </div>
        }
    </div>
}

@code {
    private string _selectedSymbol = "BTCUSDT";
    private string _selectedRangeKey = "0:10000";

    private (decimal? Min, decimal? Max) SelectedRange
    {
        get
        {
            var parts = _selectedRangeKey.Split(':', 2);
            var min = string.IsNullOrEmpty(parts[0]) ? (decimal?)null : decimal.Parse(parts[0], CultureInfo.InvariantCulture);
            var max = parts.Length < 2 || string.IsNullOrEmpty(parts[1]) ? (decimal?)null : decimal.Parse(parts[1], CultureInfo.InvariantCulture);
            return (min, max);
        }
    }

    private decimal? MinNotionalUsd => SelectedRange.Min;
    private decimal? MaxNotionalUsd => SelectedRange.Max;
}
