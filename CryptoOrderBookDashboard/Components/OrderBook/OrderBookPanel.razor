@implements IAsyncDisposable
@inject OrderBookStore Store
@inject IOptions<OrderBookDashboardOptions> Options
@inject IJSRuntime JS

<div class="order-book-panel @(_showChart && _curve is not null ? "with-chart" : "")">
    <div class="order-book-header">
        <span class="order-book-title">@Symbol <span class="order-book-market">@MarketLabel</span></span>
        <span class="order-book-status status-@_snapshot.Status.ToString().ToLowerInvariant()">@_snapshot.Status</span>
    </div>

    <div class="order-book-spread">
        @if (_snapshot is { BestBid: { } bestBid, BestAsk: { } bestAsk })
        {
            var mid = (bestBid + bestAsk) / 2;
            <span>Spread: @FormatNumber(bestAsk - bestBid)</span>
            <span>Mid: @FormatNumber(mid)</span>
        }
        @if (_snapshot.GroupStep is { } step)
        {
            <span>Group: $@FormatNumber(step)</span>
        }
    </div>

    @if (_depth is { } depth)
    {
        var bidPct = (double)(depth.BidShare * 100);
        var prefix = depth.Complete ? "" : "≥ ";
        <div class="depth-summary" title="@DepthTitle(depth)">
            <span class="depth-label">Depth @depth.Label</span>
            <span class="depth-bids">@prefix@FormatNotional(depth.BidsUsd)</span>
            <div class="depth-imbalance">
                <div class="depth-imbalance-bids" style="width:@(FormatPercent(bidPct))%"></div>
            </div>
            <span class="depth-asks">@prefix@FormatNotional(depth.AsksUsd)</span>
            <span class="depth-share">@($"{bidPct:0}% / {100 - bidPct:0}%")</span>
            <button type="button" class="depth-chart-toggle" @onclick="ToggleChart"
                    aria-expanded="@(_showChart ? "true" : "false")"
                    title="@(_showChart ? "Hide depth chart" : "Show depth chart")">@(_showChart ? "▾" : "▸")</button>
        </div>
    }

    @if (_showChart && _curve is not null)
    {
        <DepthChart Curve="_curve" />
    }

    @if (_rowsOutsideBand > 0 && _depth is { } band)
    {
        <div class="depth-band-note">
            Chart and depth bar show all orders within @band.Label; @_rowsOutsideBand table row(s) lie beyond it.
            Set Depth to Rows to chart the table.
        </div>
    }

    @if ((MinNotionalUsd is not null || MaxNotionalUsd is not null) && _snapshot.Bids.Count == 0 && _snapshot.Asks.Count == 0)
    {
        <div class="order-book-empty">No orders in the selected size range currently.</div>
    }

    <div class="order-book-columns">
        <div class="order-book-side asks">
            @{
                var maxAskQty = _snapshot.Asks.Count > 0 ? _snapshot.Asks.Max(a => a.Quantity) : 0m;
            }
            @foreach (var level in _snapshot.Asks.Reverse())
            {
                var pct = maxAskQty > 0 ? (double)(level.Quantity / maxAskQty) * 100 : 0;
                var tier = SizeTier(level.Price * level.Quantity);
                <div class="order-book-row size-tier-@tier">
                    <div class="depth-bar ask-bar" style="width:@(FormatPercent(pct))%"></div>
                    <div class="size-indicator"></div>
                    <span class="price">@FormatNumber(level.Price)</span>
                    <span class="qty">@FormatQuantity(level.Quantity)</span>
                    <span class="notional">@FormatNotional(level.Price * level.Quantity)</span>
                </div>
            }
        </div>
        <div class="order-book-spread-marker" @ref="_spreadMarker"></div>
        <div class="order-book-side bids">
            @{
                var maxBidQty = _snapshot.Bids.Count > 0 ? _snapshot.Bids.Max(b => b.Quantity) : 0m;
            }
            @foreach (var level in _snapshot.Bids)
            {
                var pct = maxBidQty > 0 ? (double)(level.Quantity / maxBidQty) * 100 : 0;
                var tier = SizeTier(level.Price * level.Quantity);
                <div class="order-book-row size-tier-@tier">
                    <div class="depth-bar bid-bar" style="width:@(FormatPercent(pct))%"></div>
                    <div class="size-indicator"></div>
                    <span class="price">@FormatNumber(level.Price)</span>
                    <span class="qty">@FormatQuantity(level.Quantity)</span>
                    <span class="notional">@FormatNotional(level.Price * level.Quantity)</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MarketType Market { get; set; }

    [Parameter, EditorRequired]
    public string Symbol { get; set; } = string.Empty;

    [Parameter]
    public int? Levels { get; set; }

    [Parameter]
    public decimal? MinNotionalUsd { get; set; }

    [Parameter]
    public decimal? MaxNotionalUsd { get; set; }

    // Price bucket as a percentage of mid; null = no grouping.
    [Parameter]
    public decimal? GroupPercent { get; set; }

    // Band around mid for the bid/ask depth summary; null = hidden.
    [Parameter]
    public decimal? DepthPercent { get; set; }

    // "Rows" depth mode: bar and chart follow the visible rows instead of a ±% band.
    [Parameter]
    public bool DepthFollowsRows { get; set; }

    // The depth chart refreshes at most once a second: the eye can't follow faster, and each
    // refresh changes the SVG paths in the SignalR diff.
    private const long CurveRefreshMilliseconds = 1000;

    private DepthCurve? _curve;
    private DepthSummary? _depth;
    private int _rowsOutsideBand;
    private readonly RowsRange _rowsRange = new();
    private bool _showChart = true;
    private string? _curveKey;
    private long _curveTicks;

    // Store version the current curve was built from; while it lags the book the pulse keeps
    // refreshing (once a second), so a book that goes quiet still ends with an up-to-date chart.
    private long _curveVersion = long.MinValue;

    private OrderBookSnapshot _snapshot = OrderBookSnapshot.Empty;
    private ElementReference _spreadMarker;
    private IJSObjectReference? _module;
    private string? _centeredKey;
    private bool _disposed;
    private OrderBookKey _key;

    // Store version the current snapshot was built from. Read on the pulse thread, written on
    // the renderer's, hence Volatile.
    private long _renderedVersion = long.MinValue;

    private string MarketLabel => DisplayFormat.MarketLabel(Market);

    private string CenterKey => $"{Market}:{Symbol}:{MinNotionalUsd}:{MaxNotionalUsd}:{GroupPercent}";

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
    }

    protected override void OnParametersSet()
    {
        _key = new OrderBookKey(Market, Symbol);
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/OrderBook/OrderBookPanel.razor.js");
        }

        if (_module is not null
            && _snapshot.Bids.Count > 0
            && _snapshot.Asks.Count > 0
            && _centeredKey != CenterKey)
        {
            _centeredKey = CenterKey;
            await _module.InvokeVoidAsync("centerSpread", _spreadMarker);
        }
    }

    // async void because it's an event handler - every exception must be caught here, since
    // one escaping onto the thread pool would take down the whole process.
    private async void OnStoreChanged()
    {
        // Nothing changed in this book since the last render - skip the render and the
        // SignalR diff entirely (common for quieter symbols).
        if (_disposed)
        {
            return;
        }

        var version = Store.GetVersion(_key);
        if (version == Volatile.Read(ref _renderedVersion) && !CurveIsDue(version))
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Circuit was torn down between the pulse and this render.
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private void Refresh()
    {
        var levels = Levels ?? Options.Value.DepthLevels;

        // Version first: if the book changes while the snapshot is being built, the next pulse
        // sees a newer version and refreshes again rather than missing the update.
        var version = Store.GetVersion(_key);
        Volatile.Write(ref _renderedVersion, version);
        _snapshot = Store.GetSnapshot(_key, levels, MinNotionalUsd, MaxNotionalUsd, GroupPercent, EffectiveDepthPercent);
        _depth = RowsMode ? RowsSummary(_snapshot) : _snapshot.Depth;
        _rowsOutsideBand = DepthFollowsRows ? 0 : RowsOutsideBand(_snapshot, EffectiveDepthPercent);
        RefreshCurve(version);
    }

    // Rows mode only makes sense with a size filter: unfiltered rows are just the top few levels.
    private bool RowsMode => DepthFollowsRows && (MinNotionalUsd is not null || MaxNotionalUsd is not null);

    private decimal? EffectiveDepthPercent =>
        RowsMode ? null : DepthPercent ?? (DepthFollowsRows ? DepthBand.RowsFallbackPercent : null);

    // In Rows mode the bar sums exactly the rows the chart draws: the visible rows within
    // ±RowsMaxPercent of mid, so bar, chart and table all tell the same story.
    private static DepthSummary? RowsSummary(OrderBookSnapshot snapshot)
    {
        if (snapshot is not { BestBid: { } bestBid, BestAsk: { } bestAsk })
        {
            return null;
        }

        var (bids, asks) = RowsWithinCap(snapshot, (bestBid + bestAsk) / 2);
        return new DepthSummary(
            "Rows",
            bids.Sum(l => l.Price * l.Quantity),
            asks.Sum(l => l.Price * l.Quantity),
            Complete: true);
    }

    // In a ±% band the chart and bar ignore the size filter and grouping, while the table can list
    // walls far beyond the band. Count those rows so the panel can say so instead of leaving the
    // chart and table to silently disagree.
    private static int RowsOutsideBand(OrderBookSnapshot snapshot, decimal? percent)
    {
        if (percent is not { } p || snapshot is not { BestBid: { } bestBid, BestAsk: { } bestAsk })
        {
            return 0;
        }

        var mid = (bestBid + bestAsk) / 2;
        var low = mid * (1 - p / 100m);
        var high = mid * (1 + p / 100m);
        return snapshot.Bids.Count(l => l.Price < low) + snapshot.Asks.Count(l => l.Price > high);
    }

    private static (List<PriceLevel> Bids, List<PriceLevel> Asks) RowsWithinCap(OrderBookSnapshot snapshot, decimal mid)
    {
        var floor = mid * (1 - DepthBand.RowsMaxPercent / 100m);
        var ceiling = mid * (1 + DepthBand.RowsMaxPercent / 100m);
        return (
            snapshot.Bids.Where(l => l.Price >= floor).ToList(),
            snapshot.Asks.Where(l => l.Price <= ceiling).ToList());
    }

    private void RefreshCurve(long version)
    {
        // A new symbol, market, band or row filter must show immediately; otherwise wait for the
        // 1s cadence.
        var curveKey = RowsMode
            ? $"{Market}:{Symbol}:rows:{MinNotionalUsd}:{MaxNotionalUsd}:{GroupPercent}"
            : $"{Market}:{Symbol}:{EffectiveDepthPercent}";
        if (curveKey == _curveKey && !CurveIsDue(version))
        {
            return;
        }

        if (curveKey != _curveKey)
        {
            _rowsRange.Reset();
        }

        _curveKey = curveKey;
        _curve = !_showChart ? null
            : RowsMode ? BuildRowsCurve(_snapshot)
            : EffectiveDepthPercent is { } percent ? Store.GetDepthCurve(_key, percent)
            : null;
        Volatile.Write(ref _curveTicks, Environment.TickCount64);
        Volatile.Write(ref _curveVersion, version);
    }

    // Built per viewer from the (at most 200) visible rows - cheap, and the axis range has
    // per-viewer hysteresis anyway.
    private DepthCurve? BuildRowsCurve(OrderBookSnapshot snapshot)
    {
        if (snapshot is not { BestBid: { } bestBid, BestAsk: { } bestAsk })
        {
            return null;
        }

        var mid = (bestBid + bestAsk) / 2;
        var (bids, asks) = RowsWithinCap(snapshot, mid);
        if (bids.Count == 0 && asks.Count == 0)
        {
            return null;
        }

        var (low, high) = _rowsRange.Update(mid, bids, asks);
        return DepthCurve.Build(mid, low, high, bids, asks, bookEnds: false, "Rows") with
        {
            RowsBeyondCap = snapshot.Bids.Count + snapshot.Asks.Count - bids.Count - asks.Count,
        };
    }

    private bool CurveIsDue(long version) =>
        _showChart
        && version != Volatile.Read(ref _curveVersion)
        && Environment.TickCount64 - Volatile.Read(ref _curveTicks) >= CurveRefreshMilliseconds;

    private void ToggleChart()
    {
        _showChart = !_showChart;
        _curveKey = null;
        RefreshCurve(Store.GetVersion(_key));
    }

    private static int SizeTier(decimal notionalUsd) => Notional.SizeTier(notionalUsd);

    private static string FormatNumber(decimal value) => DisplayFormat.Number(value);

    private static string FormatQuantity(decimal value) => DisplayFormat.Quantity(value);

    private static string FormatNotional(decimal value) => DisplayFormat.CompactUsd(value);

    private string DepthTitle(DepthSummary depth) =>
        depth.Label == "Rows"
            ? $"Sum of the visible rows within ±{DepthBand.RowsMaxPercent:0}% of mid - the same rows the chart and table show."
            : $"Resting bid and ask liquidity within {depth.Label} of mid."
            + (DepthFollowsRows ? " Rows mode needs a Min size filter, so this falls back to a band." : "")
        + (depth.Complete ? "" : " The local book does not reach the edge of this band, so these are lower bounds.");

    private static string FormatPercent(double value) => DisplayFormat.Percent(value);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Store.Changed -= OnStoreChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone - nothing to clean up on the client.
            }
        }
    }
}
