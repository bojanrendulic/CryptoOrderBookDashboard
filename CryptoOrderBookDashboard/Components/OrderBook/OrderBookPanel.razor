@implements IAsyncDisposable
@inject OrderBookStore Store
@inject IOptions<OrderBookDashboardOptions> Options
@inject IJSRuntime JS

<div class="order-book-panel">
    <div class="order-book-header">
        <span class="order-book-title">@Symbol <span class="order-book-market">@MarketLabel</span></span>
        <span class="order-book-status status-@_snapshot.Status.ToString().ToLowerInvariant()">@_snapshot.Status</span>
    </div>

    <div class="order-book-spread">
        @if (_snapshot.Bids.Count > 0 && _snapshot.Asks.Count > 0)
        {
            var bestBid = _snapshot.Bids[0].Price;
            var bestAsk = _snapshot.Asks[0].Price;
            var mid = (bestBid + bestAsk) / 2;
            <span>Spread: @FormatNumber(bestAsk - bestBid)</span>
            <span>Mid: @FormatNumber(mid)</span>
        }
    </div>

    @if ((MinNotionalUsd is not null || MaxNotionalUsd is not null) && _snapshot.Bids.Count == 0 && _snapshot.Asks.Count == 0)
    {
        <div class="order-book-empty">No orders in the selected size range currently.</div>
    }

    <div class="order-book-columns">
        <div class="order-book-side asks">
            @{
                var maxAskQty = _snapshot.Asks.Count > 0 ? _snapshot.Asks.Max(a => a.Quantity) : 0m;
            }
            @foreach (var level in _snapshot.Asks.Reverse())
            {
                var pct = maxAskQty > 0 ? (double)(level.Quantity / maxAskQty) * 100 : 0;
                var tier = SizeTier(level.Price * level.Quantity);
                <div class="order-book-row size-tier-@tier">
                    <div class="depth-bar ask-bar" style="width:@(FormatPercent(pct))%"></div>
                    <div class="size-indicator"></div>
                    <span class="price">@FormatNumber(level.Price)</span>
                    <span class="qty">@FormatNumber(level.Quantity)</span>
                </div>
            }
        </div>
        <div class="order-book-spread-marker" @ref="_spreadMarker"></div>
        <div class="order-book-side bids">
            @{
                var maxBidQty = _snapshot.Bids.Count > 0 ? _snapshot.Bids.Max(b => b.Quantity) : 0m;
            }
            @foreach (var level in _snapshot.Bids)
            {
                var pct = maxBidQty > 0 ? (double)(level.Quantity / maxBidQty) * 100 : 0;
                var tier = SizeTier(level.Price * level.Quantity);
                <div class="order-book-row size-tier-@tier">
                    <div class="depth-bar bid-bar" style="width:@(FormatPercent(pct))%"></div>
                    <div class="size-indicator"></div>
                    <span class="price">@FormatNumber(level.Price)</span>
                    <span class="qty">@FormatNumber(level.Quantity)</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MarketType Market { get; set; }

    [Parameter, EditorRequired]
    public string Symbol { get; set; } = string.Empty;

    [Parameter]
    public int? Levels { get; set; }

    [Parameter]
    public decimal? MinNotionalUsd { get; set; }

    [Parameter]
    public decimal? MaxNotionalUsd { get; set; }

    private OrderBookSnapshot _snapshot = OrderBookSnapshot.Empty;
    private ElementReference _spreadMarker;
    private IJSObjectReference? _module;
    private string? _centeredKey;
    private bool _disposed;
    private OrderBookKey _key;

    // Store version the current snapshot was built from. Read on the pulse thread, written on
    // the renderer's, hence Volatile.
    private long _renderedVersion = long.MinValue;

    private string MarketLabel => DisplayFormat.MarketLabel(Market);

    private string CenterKey => $"{Market}:{Symbol}:{MinNotionalUsd}:{MaxNotionalUsd}";

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
    }

    protected override void OnParametersSet()
    {
        _key = new OrderBookKey(Market, Symbol);
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/OrderBook/OrderBookPanel.razor.js");
        }

        if (_module is not null
            && _snapshot.Bids.Count > 0
            && _snapshot.Asks.Count > 0
            && _centeredKey != CenterKey)
        {
            _centeredKey = CenterKey;
            await _module.InvokeVoidAsync("centerSpread", _spreadMarker);
        }
    }

    // async void because it's an event handler - every exception must be caught here, since
    // one escaping onto the thread pool would take down the whole process.
    private async void OnStoreChanged()
    {
        // Nothing changed in this book since the last render - skip the render and the
        // SignalR diff entirely (common for quieter symbols).
        if (_disposed || Store.GetVersion(_key) == Volatile.Read(ref _renderedVersion))
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Circuit was torn down between the pulse and this render.
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private void Refresh()
    {
        var levels = Levels ?? Options.Value.DepthLevels;

        // Version first: if the book changes while the snapshot is being built, the next pulse
        // sees a newer version and refreshes again rather than missing the update.
        Volatile.Write(ref _renderedVersion, Store.GetVersion(_key));
        _snapshot = Store.GetSnapshot(_key, levels, MinNotionalUsd, MaxNotionalUsd);
    }

    private static int SizeTier(decimal notionalUsd) => Notional.SizeTier(notionalUsd);

    private static string FormatNumber(decimal value) => DisplayFormat.Number(value);

    private static string FormatPercent(double value) => DisplayFormat.Percent(value);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Store.Changed -= OnStoreChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone - nothing to clean up on the client.
            }
        }
    }
}
