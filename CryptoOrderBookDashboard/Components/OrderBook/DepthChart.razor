@using System.Globalization
@using System.Text
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Cumulative bid/ask depth ("V" chart) within ±X% of mid. Plain SVG stretched to the panel width;
   all text lives in HTML around it, because a non-uniformly scaled SVG would distort glyphs.
   The hover crosshair/tooltip is drawn entirely in the browser (DepthChart.razor.js) from the
   data-curve attribute, so moving the mouse never round-trips to the server. *@
<div class="depth-chart">
    <div class="depth-chart-max" style="left:@F(LabelFraction * 100)%">max @MaxLabel</div>
    <div class="depth-chart-plot" @ref="_plot">
        <svg class="depth-chart-svg" viewBox="0 0 @F(Width) @F(Height)" preserveAspectRatio="none"
             role="img" aria-label="@AriaLabel" data-curve="@CurveData">
            <line class="mid-line" x1="@F(MidX)" x2="@F(MidX)" y1="0" y2="@F(Height)" />
            @* Past the snapshot boundary the curve is drawn faint and dashed (learned from live
               updates only); the reliable part is drawn over it in full colour. *@
            @if (BidReliable < Curve.BidSteps)
            {
                <path class="area-bid partial" d="@AreaPath(Curve.Bids, Curve.BidSteps, -1)" />
                <path class="line-bid partial" d="@LinePath(Curve.Bids, Curve.BidSteps, -1)" />
            }
            @if (BidReliable > 0)
            {
                <path class="area-bid" d="@AreaPath(Curve.Bids, BidReliable, -1)" />
                <path class="line-bid" d="@LinePath(Curve.Bids, BidReliable, -1)" />
            }
            @if (AskReliable < Curve.AskSteps)
            {
                <path class="area-ask partial" d="@AreaPath(Curve.Asks, Curve.AskSteps, 1)" />
                <path class="line-ask partial" d="@LinePath(Curve.Asks, Curve.AskSteps, 1)" />
            }
            @if (AskReliable > 0)
            {
                <path class="area-ask" d="@AreaPath(Curve.Asks, AskReliable, 1)" />
                <path class="line-ask" d="@LinePath(Curve.Asks, AskReliable, 1)" />
            }
        </svg>
        @* Owned by JS: Blazor never renders children here, so the overlay survives re-renders. *@
        <div class="depth-chart-overlay"></div>
    </div>
    <div class="depth-chart-axis">
        <span>@DisplayFormat.Number(RoundPrice(Curve.Low)) <span class="axis-pct">@PctFromMid(Curve.Low)</span></span>
        @if (ShowMidLabel)
        {
            <span class="axis-mid" style="left:@F(MidFraction * 100)%">Mid @DisplayFormat.Number(RoundPrice(Curve.Mid))</span>
        }
        <span>@DisplayFormat.Number(RoundPrice(Curve.High)) <span class="axis-pct">@PctFromMid(Curve.High)</span></span>
    </div>
    @if (!Curve.Complete)
    {
        <div class="depth-chart-note">The local book ends inside this band; the curve stops where the data does.</div>
    }
    @if (!Curve.Reliable)
    {
        <div class="depth-chart-note">@PartialNote</div>
    }
    @if (Curve.RowsBeyondCap > 0)
    {
        <div class="depth-chart-note">@Curve.RowsBeyondCap row(s) beyond ±@DepthBand.RowsMaxPercent.ToString("0", CultureInfo.InvariantCulture)% of mid are listed below but left out of the chart and the depth bar.</div>
    }
</div>

@code {
    private const double Width = 600;
    private const double Height = 120;

    [Parameter, EditorRequired]
    public DepthCurve Curve { get; set; } = default!;

    private ElementReference _plot;
    private IJSObjectReference? _module;


    private int BidReliable => Math.Min(Curve.BidReliable, Curve.BidSteps);

    private int AskReliable => Math.Min(Curve.AskReliable, Curve.AskSteps);

    private string PartialNote
    {
        get
        {
            if (Curve.Boundary is not { } boundary)
            {
                return "Waiting for the order book snapshot; the curve may be incomplete.";
            }

            return string.Create(CultureInfo.InvariantCulture,
                $"Faint part: beyond the sync snapshot (−{boundary.BidReachPercent(Curve.Mid):0.##}% / +{boundary.AskReachPercent(Curve.Mid):0.##}%), " +
                $"learned from live updates since {boundary.SyncedUtc.ToLocalTime():HH:mm} — orders that haven't changed since are missing, so it may be too low.");
        }
    }
    private decimal Scale => Curve.MaxUsd > 0 ? Curve.MaxUsd * 1.05m : 1m;

    // "mid;low;high;scale;bidSteps;askSteps;bidReliable;askReliable;bids…;asks…" with comma-separated whole-dollar sums.
    // Changes only when the curve does (at most once a second), like the paths themselves.
    private string CurveData
    {
        get
        {
            var sb = new StringBuilder();
            sb.Append(Curve.Mid.ToString(CultureInfo.InvariantCulture)).Append(';')
                .Append(Curve.Low.ToString(CultureInfo.InvariantCulture)).Append(';')
                .Append(Curve.High.ToString(CultureInfo.InvariantCulture)).Append(';')
                .Append(Math.Round(Scale).ToString(CultureInfo.InvariantCulture)).Append(';')
                .Append(Curve.BidSteps).Append(';')
                .Append(Curve.AskSteps).Append(';')
                .Append(BidReliable).Append(';')
                .Append(AskReliable).Append(';');
            AppendSums(sb, Curve.Bids, Curve.BidSteps);
            sb.Append(';');
            AppendSums(sb, Curve.Asks, Curve.AskSteps);
            return sb.ToString();
        }
    }

    private static void AppendSums(StringBuilder sb, IReadOnlyList<decimal> values, int count)
    {
        for (var i = 0; i < count; i++)
        {
            if (i > 0)
            {
                sb.Append(',');
            }

            sb.Append(Math.Round(values[i]).ToString(CultureInfo.InvariantCulture));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/OrderBook/DepthChart.razor.js");
            await _module.InvokeVoidAsync("attach", _plot);
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away before the chart finished initialising.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("detach", _plot);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone - the DOM and its listeners went with it.
        }
    }

    private string MaxLabel => DisplayFormat.CompactUsd(Curve.MaxUsd);

    private string AriaLabel =>
        $"Cumulative depth ({Curve.Label}) from {RoundPrice(Curve.Low)} to {RoundPrice(Curve.High)}, up to {MaxLabel}";

    // Linear price axis from Low to High; mid sits wherever it falls (centred in ±% mode).
    private double MidFraction => Curve.High > Curve.Low ? (double)((Curve.Mid - Curve.Low) / (Curve.High - Curve.Low)) : 0.5;

    private double MidX => Width * MidFraction;

    // Near an edge the mid label would collide with the edge price label; the dashed mid line
    // and the panel header still show where mid is.
    private bool ShowMidLabel => MidFraction is >= 0.2 and <= 0.8;

    // Labels pinned to mid, kept clear of the edge labels. Next to mid the curves are at their
    // lowest, so the "max" label there never covers them.
    private double LabelFraction => Math.Clamp(MidFraction, 0.15, 0.85);

    private double StepWidth(int direction) => (direction < 0 ? MidX : Width - MidX) / DepthCurve.Steps;

    private double X(int step, int direction) => MidX + direction * (step + 1) * StepWidth(direction);

    private string PctFromMid(decimal price) =>
        Curve.Mid > 0 ? DisplayFormat.SignedPercent((price - Curve.Mid) / Curve.Mid * 100m, 1) : "";

    private double Y(decimal cumulative) => Height - (double)(cumulative / Scale) * Height;

    // Step line from mid outwards: each point holds its level, then jumps at the next edge, so a
    // big wall shows as a vertical cliff instead of a gentle slope.
    private string LinePath(IReadOnlyList<decimal> values, int count, int direction)
    {
        var sb = new StringBuilder();
        sb.Append("M").Append(F(MidX)).Append(' ').Append(F(Height));
        var previousY = Height;
        for (var i = 0; i < count; i++)
        {
            var x = X(i, direction);
            var y = Y(values[i]);
            sb.Append(" H").Append(F(x - direction * StepWidth(direction)));
            if (y != previousY)
            {
                sb.Append(" V").Append(F(y));
            }

            previousY = y;
        }

        sb.Append(" H").Append(F(X(count - 1, direction)));
        return sb.ToString();
    }

    private string AreaPath(IReadOnlyList<decimal> values, int count, int direction) =>
        LinePath(values, count, direction) + " V" + F(Height) + " Z";

    // Axis labels only need a readable price, not the full tick precision.
    private static decimal RoundPrice(decimal price) => price switch
    {
        >= 1000m => Math.Round(price, 0),
        >= 1m => Math.Round(price, 2),
        _ => Math.Round(price, 6),
    };

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
