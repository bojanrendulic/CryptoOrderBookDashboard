@implements IDisposable
@inject TradeStore Store
@inject HistoricalTradeSearchService SearchService

<div class="trade-tape-panel">
    <div class="trade-tape-header">
        <span class="trade-tape-title">@Symbol <span class="trade-tape-market">@MarketLabel</span></span>
    </div>

    <div class="trade-tape-delta">
        <span class="buy">Buy (60s): @FormatUsd(_buyVolumeUsd)</span>
        <span class="sell">Sell (60s): @FormatUsd(_sellVolumeUsd)</span>
        <span class="delta @DeltaClass">Delta: @FormatUsd(_buyVolumeUsd - _sellVolumeUsd)</span>
    </div>

    @if ((MinNotionalUsd is not null || MaxNotionalUsd is not null) && _trades.Count == 0)
    {
        <div class="trade-tape-empty">
            <div>No trades in the selected size range currently.</div>
            <button class="btn btn-sm btn-outline-light mt-2" @onclick="() => StartSearch(7)" disabled="@_isSearching">
                Find matching trades (last 7 days)
            </button>
            <button class="btn btn-sm btn-outline-light mt-2" @onclick="() => StartSearch(30)" disabled="@_isSearching">
                Find matching trades (last 30 days)
            </button>
            @if (_isSearching)
            {
                <button class="btn btn-sm btn-outline-danger mt-2" @onclick="CancelSearch">Cancel</button>
            }

            @if (_isSearching)
            {
                <div class="trade-tape-search-result">
                    @if (_searchProgress is { IsQueued: true })
                    {
                        <span>Waiting for a free search slot — other searches are running on the server...</span>
                    }
                    else if (_searchProgress is { } p)
                    {
                        <span>Searching (last @_searchLookbackDays days)... found @p.MatchesSoFar so far, checked back to @p.SearchedBackToUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss").</span>
                    }
                    else
                    {
                        <span>Searching (last @_searchLookbackDays days)...</span>
                    }
                </div>
            }
            else if (_searchResult is not null)
            {
                <div class="trade-tape-search-result">
                    @switch (_searchResult.Status)
                    {
                        case HistoricalTradeSearchStatus.Completed when _historicalMatches.Count == 0:
                            <span>No matching trades found in the last @_searchLookbackDays days.</span>
                            break;
                        case HistoricalTradeSearchStatus.Completed:
                            <span>Found @_historicalMatches.Count matching trade(s) in the last @_searchLookbackDays days (shown below).</span>
                            break;
                        case HistoricalTradeSearchStatus.Incomplete:
                            <span>Found @_historicalMatches.Count matching trade(s) in the last @_searchLookbackDays days, but some very busy hours were only partially scanned — there may be more.</span>
                            break;
                        case HistoricalTradeSearchStatus.TimedOut:
                            <span>Search stopped early (took too long) — found @_historicalMatches.Count so far, checked back to @_searchResult.SearchedBackToUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss").</span>
                            break;
                        case HistoricalTradeSearchStatus.ApiError:
                            <span>Search stopped early (API error, likely rate-limited) — found @_historicalMatches.Count so far, checked back to @_searchResult.SearchedBackToUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss"). Try again in a minute.</span>
                            break;
                        case HistoricalTradeSearchStatus.MatchLimitReached:
                            <span>Showing the most recent @_historicalMatches.Count matches — there may be more further back.</span>
                            break;
                        case HistoricalTradeSearchStatus.Cancelled:
                            <span>Search cancelled — found @_historicalMatches.Count so far, checked back to @_searchResult.SearchedBackToUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss").</span>
                            break;
                    }
                </div>
            }
        </div>
    }

    <div class="trade-tape-rows">
        @foreach (var trade in _trades)
        {
            @RenderRow(trade, showDate: false)
        }
        @foreach (var historicalTrade in _historicalMatches)
        {
            @RenderRow(historicalTrade, showDate: true)
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MarketType Market { get; set; }

    [Parameter, EditorRequired]
    public string Symbol { get; set; } = string.Empty;

    [Parameter]
    public decimal? MinNotionalUsd { get; set; }

    [Parameter]
    public decimal? MaxNotionalUsd { get; set; }

    private static readonly TimeSpan DeltaWindow = TimeSpan.FromSeconds(60);

    // The 60s delta keeps decaying even when no trades arrive, so a quiet market still
    // refreshes at this rate instead of only on new trades.
    private const long IdleRefreshMilliseconds = 1000;

    private IReadOnlyList<TradeEntry> _trades = [];
    private decimal _buyVolumeUsd;
    private decimal _sellVolumeUsd;
    private bool _isSearching;
    private int _searchLookbackDays;
    private HistoricalTradeSearchResult? _searchResult;
    private HistoricalTradeSearchProgress? _searchProgress;
    private List<TradeEntry> _historicalMatches = [];
    private CancellationTokenSource? _searchCts;
    private bool _disposed;
    private OrderBookKey _key;

    // Read on the pulse thread, written on the renderer's, hence Volatile.
    private long _renderedVersion = long.MinValue;
    private long _lastRefreshTicks;

    private string MarketLabel => DisplayFormat.MarketLabel(Market);

    private string DeltaClass => _buyVolumeUsd >= _sellVolumeUsd ? "buy" : "sell";

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
    }

    protected override void OnParametersSet()
    {
        // The panel instance is reused when the symbol or size range changes, so detach the
        // running search entirely - otherwise its (old symbol's) result would still be applied.
        CancelSearch();
        _searchCts = null;
        _isSearching = false;
        _searchResult = null;
        _searchProgress = null;
        _historicalMatches = [];
        _key = new OrderBookKey(Market, Symbol);
        Refresh();
    }

    private void StartSearch(int lookbackDays)
    {
        CancelSearch();
        var cts = new CancellationTokenSource();
        _searchCts = cts;

        _isSearching = true;
        _searchLookbackDays = lookbackDays;
        _searchResult = null;
        _searchProgress = null;
        _historicalMatches = [];

        _ = RunSearchAsync(lookbackDays, cts);
    }

    private void CancelSearch()
    {
        try
        {
            _searchCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // A previous search already finished and disposed its token source.
        }
    }

    private async Task RunSearchAsync(int lookbackDays, CancellationTokenSource cts)
    {
        var progress = new Progress<HistoricalTradeSearchProgress>(p => ReportProgress(p, cts));

        try
        {
            var result = await SearchService.FindTradesInRangeAsync(
                Market, Symbol, MinNotionalUsd, MaxNotionalUsd, lookbackDays, progress, cts.Token);

            if (_disposed || _searchCts != cts)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                if (_disposed || _searchCts != cts)
                {
                    return;
                }

                _searchResult = result;
                _historicalMatches = result.Matches
                    .Select(m => new TradeEntry(m.Id, m.Price, m.Quantity, m.BuyerIsMaker, m.TradeTimeUtc))
                    .ToList();
                _isSearching = false;
                StateHasChanged();
            });
        }
        catch (Exception) when (!_disposed && _searchCts == cts)
        {
            // Without this the fire-and-forget search would leave the panel stuck on
            // "Searching..." with its buttons disabled.
            await InvokeAsync(() =>
            {
                _searchResult = new HistoricalTradeSearchResult(HistoricalTradeSearchStatus.ApiError, [], DateTime.UtcNow);
                _isSearching = false;
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Search was superseded or the panel is gone - nobody is waiting for this result.
        }
        finally
        {
            // Once this search's token source is disposed, drop the shared reference so a
            // later Cancel() (e.g. from OnParametersSet or a fresh StartSearch) can't hit it.
            if (_searchCts == cts)
            {
                _searchCts = null;
            }

            cts.Dispose();
        }
    }

    private void ReportProgress(HistoricalTradeSearchProgress p, CancellationTokenSource cts)
    {
        if (_disposed || _searchCts != cts)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed || _searchCts != cts)
            {
                return;
            }

            _searchProgress = p;
            StateHasChanged();
        });
    }

    // async void because it's an event handler - every exception must be caught here, since
    // one escaping onto the thread pool would take down the whole process.
    private async void OnStoreChanged()
    {
        if (_disposed)
        {
            return;
        }

        var unchanged = Store.GetVersion(_key) == Volatile.Read(ref _renderedVersion);
        var recentlyRefreshed = Environment.TickCount64 - Volatile.Read(ref _lastRefreshTicks) < IdleRefreshMilliseconds;
        if (unchanged && recentlyRefreshed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Circuit was torn down between the pulse and this render.
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private void Refresh()
    {
        // Version first, so a trade arriving mid-refresh is picked up on the next pulse.
        Volatile.Write(ref _renderedVersion, Store.GetVersion(_key));
        Volatile.Write(ref _lastRefreshTicks, Environment.TickCount64);
        _trades = Store.GetTrades(_key, MinNotionalUsd, MaxNotionalUsd);
        (_buyVolumeUsd, _sellVolumeUsd) = Store.GetVolumeDelta(_key, DeltaWindow, MinNotionalUsd, MaxNotionalUsd);
    }

    private RenderFragment RenderRow(TradeEntry trade, bool showDate)
    {
        var side = trade.BuyerIsMaker ? "sell" : "buy";
        var tier = SizeTier(trade.Price * trade.Quantity);
        var cssClass = showDate
            ? $"trade-row {side} size-tier-{tier} historical"
            : $"trade-row {side} size-tier-{tier}";
        var time = showDate
            ? trade.TradeTimeUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
            : trade.TradeTimeUtc.ToLocalTime().ToString("HH:mm:ss.fff");

        return @<div class="@cssClass">
            <div class="size-indicator"></div>
            <span class="time">@time</span>
            <span class="price">@FormatNumber(trade.Price)</span>
            <span class="qty">@FormatNumber(trade.Quantity)</span>
            <span class="notional">@FormatNotional(trade.Price * trade.Quantity)</span>
        </div>;
    }

    private static int SizeTier(decimal notionalUsd) => Notional.SizeTier(notionalUsd);

    private static string FormatNumber(decimal value) => DisplayFormat.Number(value);

    private static string FormatUsd(decimal value) => DisplayFormat.Usd(value);

    private static string FormatNotional(decimal value) => DisplayFormat.CompactUsd(value);

    public void Dispose()
    {
        _disposed = true;
        Store.Changed -= OnStoreChanged;

        // RunSearchAsync's finally disposes the token source once the search unwinds.
        CancelSearch();
    }
}
